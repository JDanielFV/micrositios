# .htaccess - Intento Final
Options +FollowSymLinks -MultiViews
RewriteEngine On

# Condición: No es un directorio
RewriteCond %{REQUEST_FILENAME} !-d

# Condición: El archivo .html correspondiente existe
RewriteCond %{REQUEST_FILENAME}.html -f

# Regla: Reescribe la URL (sin extensión) a la versión .html
RewriteRule ^([^.]+)$ $1.html [NC,L]