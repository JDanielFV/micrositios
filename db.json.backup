        "hero": {
          "title": "M. en D. Flor Kiwan",
          "subtitle": "Titular Notaría 23 del Estado de México",
          "videoUrl": "/uploads/not23edomex/Fondos23.m4v",
          "logoUrl": "/uploads/not-23-edomex/hero_logo.png",
          "button": {
            "text": "Pongamonos en contacto",
            "link": "/contacto"
          }
        },
        "about": {
          "title": "Quien soy",
          "text": "Tercera Generación de una familia de Notarios, con experiencia en el ámbito Notarial por más de 12 años, nombrada como Notaria de la Notaria 23 del Estado de México en el año de 2011 y desempeñando ese cargo hasta la fecha.",
          "imageUrl": ""
        },
        "mainContact": {
          "title": "Trabajemos juntos",
          "text": "Contamos con un equipo administrativo altamente calificado y tecnología avanzada, lo que nos permite ofrecer un servicio rápido y eficiente, manteniendo siempre el contacto directo y asesoría personalizada para asegurar certeza jurídica en cada proceso.",
          "button": {
            "text": "Conoce nuestros servicios",
            "link": "/servicios"
          }
        },
