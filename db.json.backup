          }
        ],
        "hero": {
          "title": "Trabaja con los mejores abogados en la Riviera Maya",
          "subtitle": "Aseguramos el mayor estándar de calidad para brindar la mejor asistencia y seguridad legal que nuestros clientes se merecen.",
          "videoUrl": "/uploads/loes/16902338-sd_960_540_30fps.mp4",
          "logoUrl": "/uploads/loes/AttorneysBlanco-300x300.png",
          "button": {
            "text": "Conozca nuestros servicios",
            "link": "/servicios"
          }
        },
        "about": {
          "title": "Sobre Loes",
          "text": "Estamos comprometidos con la excelencia legal en el paraíso de la Riviera Maya. Nuestra misión es clara: guiar a nuestros clientes a través de los desafíos legales con el más alto nivel de servicio. Con un profundo entendimiento de la ley y un conocimiento único de las complejidades de la región, somos tu socio de confianza en cada paso del camino.",
          "imageUrl": ""
        },
        "mainContact": {
          "title": "¡Esperamos trabajar con usted!",
          "text": "Su viaje con nosotros comienza con un simple \"hola\". \nComience la conversación hoy y logremos grandes cosas juntos.",
          "button": {
            "text": "Reservar una reunión",
            "link": "/contacto"
          }
        },
        "locationPage": {
          "address": "Golf drive 302, Playacar, 77717 Playa del Carmen, Q.R.",
          "mapIframeUrl": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3734.34782724058!2d-87.0926814!3d20.6146745!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f4e43ab548ac489%3A0x9988eb585a76c573!2sLOES%20Attorneys!5e0!3m2!1ses-419!2smx!4v1762532248914!5m2!1ses-419!2smx"
        },
