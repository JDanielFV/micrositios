              "title": "Rectificaciones y Cotejos",
              "description": "Corrección de errores en instrumentos públicos y cotejo de documentos con sus originales para certificar su autenticidad."
            },
            {
              "title": "Hipoteca y Fideicomiso",
              "description": "Formalización de créditos hipotecarios y constitución de fideicomisos para la administración de bienes."
            }
          ]
        },
