        "servicesPage": {
          "title": "Nuestros Servicios Notariales",
          "services": [
            {
              "title": "Testamentos",
              "description": "Garantice la voluntad de sus seres queridos y la protección de su patrimonio a través de un testamento debidamente formalizado."
            },
            {
              "title": "Compraventas e Inmuebles",
              "description": "Asesoría y protocolización de contratos de compraventa de bienes inmuebles, donaciones, hipotecas y fideicomisos para la seguridad de su patrimonio."
            },
            {
              "title": "Poderes Notariales",
              "description": "Otorgue facultades a terceros para que actúen en su nombre de forma segura y legal, ya sea para asuntos generales o especiales."
            },
            {
              "title": "Constitución de Sociedades",
              "description": "Creación y formalización de personas morales, actas de asamblea, protocolización de estatutos y modificaciones sociales."
            },
            {
              "title": "Sucesiones Intestamentarias",
              "description": "Tramitamos sucesiones sin testamento, garantizando la adjudicación legal de bienes a los herederos legítimos."
            },
            {
              "title": "Fe de Hechos",
              "description": "Damos constancia de hechos y situaciones que pueden tener implicaciones legales, asegurando su validez jurídica."
            },
            {
              "title": "Actas y Contratos",
              "description": "Formalización de diversos tipos de contratos, actas constitutivas, de asamblea y otros documentos legales con la certeza que requiere."
            },
            {
