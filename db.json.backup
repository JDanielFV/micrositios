        "servicesPage": {
          "title": "Conoce nuestros servicios",
          "services": [
            {
              "title": "Sociedades y corporativos",
              "description": "Los tramites relativos a las sociedades civiles y mercantiles desde su creación, funcionamiento, disolución y liquidación."
            },
            {
              "title": "Personales",
              "description": "Los tramites personales pueden ser de distinta índole como son: Testamentos, poderes, sucesiones, divorcios, etc."
            },
            {
              "title": "Inmobiliarios",
              "description": "Todos los tramites relativos a los bienes inmuebles como son: Compra venta de casas, créditos, donaciones, fusión de predios, etc."
            },
            {
              "title": "Tramites notariales y solución de controversias.",
              "description": "Tramites generales como son: Notificaciones, ratificación de contenido y firma."
            }
